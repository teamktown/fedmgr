{
  "name": "@letsfederate/fedvec",
  "version": "0.0.1",
  "description": "Local, zero-server semantic search over federation entities — RuVector .rvf (single-file HNSW) + offline ONNX embeddings",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teamktown/fedmgr.git",
    "directory": "packages/fedvec"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build --silent"
  },
  "dependencies": {
    "@ruvector/rvf": "^0.2.2",
    "fastembed": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0 <27.0.0"
  },
  "license": "MIT"
}
