{
  "name": "@letsfederate/tmi-server",
  "version": "0.0.1",
  "description": "Trustmark Issuer service — issues signed OIDF trustmarks, serves JWKS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build --silent"
  },
  "dependencies": {
    "@letsfederate/kms": "*",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teamktown/fedmgr.git",
    "directory": "packages/tmi-server"
  },
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "license": "MIT"
}
