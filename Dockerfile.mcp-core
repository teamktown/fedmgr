# --- Build Stage ---
# Use Node.js 20 LTS on the latest compatible Alpine version as the builder
FROM node:current-alpine3.21 AS builder  

ARG FEDMGR_BUILD_REL_NPM_DIR
RUN test -n "$FEDMGR_BUILD_REL_NPM_DIR" || (echo "FEDMGR_BUILD_REL_NPM_DIR build arg is required" && exit 1)


WORKDIR /usr/src/app

# Copy the packaged application
COPY ${FEDMGR_BUILD_REL_NPM_DIR}/letsfederate-mcp-core-*.tgz ./

# Install the package using npm
# --omit=dev: Ensures only production dependencies are installed
# --ignore-scripts: Enhances security by not running arbitrary package scripts
RUN npm install ./letsfederate-mcp-core-*.tgz --omit=dev --ignore-scripts

# --- Production Stage ---
# Use a fresh  image for the final stage
FROM node:current-alpine3.21 AS final

WORKDIR /usr/src/app

# Create a non-root user and group
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy only the installed application and node_modules from the builder stage
# Set ownership directly during copy
COPY --chown=appuser:appgroup --from=builder /usr/src/app/node_modules ./node_modules

# Switch to the non-root user before running the application
USER appuser

# Expose port (Uncomment and change if your app listens on a specific port)
# EXPOSE 3000

# Define the command to run the application
# The entrypoint script is inside node_modules as per the original CMD
CMD ["node", "node_modules/@letsfederate/mcp-core/dist/server.js"]
