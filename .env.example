# fedmgr — example environment
#
# Copy to .env and set what you need. The local lab (./examples/lab/up.sh) works
# with defaults; the values below matter mainly for real deployments. Leave
# secrets BLANK here and set them out of band — never commit real secrets.

# ── Logging / policy ──────────────────────────────────────────────────────
LOG_LEVEL=info                      # trace|debug|info|warn|error
TRUST_POLICY=strict                 # strict|permissive|audit

# ── Signing (KMS) ─────────────────────────────────────────────────────────
FEDMGR_KMS_PROVIDER=softkms         # softkms | pkcs11 | openbao-transit
# OpenBao/Vault Transit (only if provider=openbao-transit):
# OPENBAO_ADDR=
# OPENBAO_TOKEN=
# OPENBAO_TRANSIT_MOUNT=transit
# OPENBAO_TRANSIT_KEY=fedmgr-oidf-signing

# ── Trust Anchor (packages/ta-server) ─────────────────────────────────────
TA_ENTITY_ID=https://ta.example                 # the anchor's entity id (= its URL)
TA_JWKS_URL=https://ta.example/.well-known/jwks.json
# Which issuers the anchor authorizes for which trust mark types (top-level
# trust_mark_issuers claim). JSON: { "<type>": ["<issuer entity id>"] }
# TA_TRUST_MARK_ISSUERS={"https://letsfederate.org/tm/mcp":["https://tmi.example"]}
# ADMIN_TOKEN=                                    # guards trust-mutating admin endpoints

# ── Trust Mark Issuer (packages/tmi-server) ───────────────────────────────
TMI_ISSUER=https://tmi.example
TMI_JWKS_URL=https://tmi.example/.well-known/jwks.json
TMI_AUTHORITY_HINTS=["https://ta.example"]       # the anchor the TMI enrolls under
# TMI_ISSUE_TOKEN=                                # bearer secret for POST /trustmarks/issue
# Supply-chain gate: artifact-bound marks require signed SSC evidence.
TMI_REQUIRE_SSC_EVIDENCE=true
# TMI_SSC_SIGNER_JWKS={"keys":[...]}              # pinned public keys of the SSC signer
# TMI_ANCHOR_JWKS={"keys":[...]}                  # hard-pin the anchor for the self-gate

# ── waypoint (packages/waypoint) ──────────────────────────────────────────
# WAYPOINT_CONFIG=./waypoint.config.json          # downstreams + accepted anchors
# WAYPOINT_ANCHOR_JWKS={"https://ta.example":{"keys":[...]}}   # hard-pin anchors (recommended)
# WAYPOINT_HTTP_PORT=8077
# Inbound identity (OAuth/OIDC) when exposing waypoint over HTTP:
# WAYPOINT_OIDC_ISSUER=
# WAYPOINT_OIDC_AUDIENCE=
# WAYPOINT_OIDC_JWKS_URI=

NODE_ENV=production
