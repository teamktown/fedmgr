# Federation Manager Configuration
# Copy this file to .env and adjust the values as needed

# Base directories (standardized build structure)
FEDMGR_HOME=/usr/src/app
FEDMGR_BUILD_DIR=./build/install
FEDMGR_KEYS_PATH=./build/install/keys
FEDMGR_FEDERATIONS_DIR=./build/install/federations
FEDMGR_FED_REG_DIR=./build/install/fed-reg
FEDMGR_FED_REG_FILE=./build/install/fed-reg/registry.json

# Federation settings
FEDERATION_NAME=alpha
FEDMGR_FEDERATION_PORT=3001

# Build settings
FEDMGR_BUILD_REL_NPM_DIR=./build/npm

# Signing provider settings
# OpenID Federation workspace packages prefer provider-owned signing. Use
# FEDMGR_KMS_PROVIDER=openbao-transit for OpenBao/Vault Transit, softkms for
# encrypted local JWKs, or pkcs11 for HSM-backed deployments.
FEDMGR_KMS_PROVIDER=softkms
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=dev-only-root-token
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_TRANSIT_KEY=fedmgr-oidf-signing

# OIDC Provider settings
OIDC_PROVIDER_HOST=localhost
OIDC_PROVIDER_PORT=6432
OIDC_PROVIDER_INTERNAL_PORT=3000
OIDC_PROVIDER_URL=http://localhost:6432
OIDC_CLIENT_ID=fedmgr-cli
OIDC_CLIENT_SECRET=fedmgr-cli-secret

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_REDIRECT_URI=http://localhost:3001/oauth/callback
OAUTH_STATE_SECRET=your-random-secret

# Admin Access Control
# Comma-separated list of GitHub usernames that should have admin privileges
FEDMGR_ADMIN_USERS=admin-username,another-admin
# Alternative: Single admin user
# FEDMGR_ADMIN_USER=admin-username

# MCP Core settings
MCP_PORT=3000
MCP_HOST=0.0.0.0
MCP_ID=mcp-demo-server
MCP_PUBLIC_KEY=mcp-demo-public-key
MCP_BASE_URL=http://localhost:3000
MCP_PUBLIC_DIR=/usr/src/app/public-mcp

# Trust and storage paths
TRUST_STORE_PATH=/usr/src/app/data/trust-store.json
STATS_STORAGE_PATH=/usr/src/app/data/stats.json

# Federation Admin settings
FEDMGR_PUBLIC_DIR=/usr/src/app/public
FEDERATION_ADMIN_URL=http://federation-admin:3001

# Development settings
NODE_ENV=development
DEBUG=fedmgr:*
