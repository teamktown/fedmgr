./reports/*
./reports

CLAUDE.md
context
test-federations/
./build
prompts
filter.txt
# ---- KMS / secrets — NEVER commit these ----
packages/*/keys/*.priv.jwe
services/*/keys/*.priv.jwe
packages/*/keys/*.priv.jwk
services/*/keys/*.priv.jwk
packages/*/keys/.pass
services/*/keys/.pass
*.priv.jwk
# key backups (e.g. keys/p256-backup-YYYY-MM-DD/) — local only, never committed
packages/*/keys/*/
services/*/keys/*/

# TypeScript build output
packages/*/dist/
packages/*/.tmp/
packages/*/test/.tmp/

# Local semantic index (regenerable) + lab-generated public JWKs (regenerated by up.sh)
.ruvector/
packages/*/keys/*.pub.jwk
services/*/keys/*.pub.jwk

# SSC scanner raw outputs (ephemeral; only the markdown reports are committed)
SSC/raw/

# validate-before-run manifest is generated from dist at publish (prepublishOnly),
# not committed — it changes every build. Regenerate: npm run provenance:gen.
packages/fedmgr/provenance/
# ...but SSC reports ARE committed — the broad `reports/` rule above would
# otherwise hide them. Re-include the dir and its contents.
!SSC/reports/
!SSC/reports/**
