{
  "name": "FedMgr Development Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "installTools": true, // includes nvm/node tools

      "enableGlobalCache": false, // default is fine; set true for pnpm global cache

      "nodeGypDependencies": true // installs build deps for native modules // or "20", "22.10", etc.
    }
  },

  /* "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "FedMgr Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Admin Interface",
      "onAutoForward": "silent"
    }
  },
  */

  "containerEnv": {
    "NODE_ENV": "development"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-node-azure-pack",
        "ms-vscode.vscode-json",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "ms-vscode.test-adapter-converter",
        "hbenl.vscode-test-explorer",
        "ms-vscode.js-debug",
        "ms-vscode.vscode-typescript-next",
        "ms-python.python",
        "ms-vscode.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.shell.linux": "/bin/bash",
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/build/**": true,
          "**/coverage/**": true,
          "**/logs/**": true
        }
      }
    }
  },

  "onCreateCommand": "true",
  "postCreateCommand": "true",
  //  "postStartCommand": "true",
  //  "onCreateCommand": "npm install",
  // "postCreateCommand": "chmod +x scripts/*.sh && chmod +x claude-flow",
  // "postStartCommand": "npm run test:unit",

  "postStartCommand": "sudo /usr/local/share/docker-init.sh",
  "runArgs": [
    "--privileged",
    "--init",
    "--tmpfs",
    "/tmp",
    "--tmpfs",
    "/run",
    "--cgroupns=host"
  ],

  "remoteUser": "vscode",
  "workspaceFolder": "/workspace"

  /*  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ]
*/
}
