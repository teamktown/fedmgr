FROM node:current-alpine3.21 AS builder

ARG FEDMGR_BUILD_REL_NPM_DIR
RUN test -n "$FEDMGR_BUILD_REL_NPM_DIR" || (echo "FEDMGR_BUILD_REL_NPM_DIR build arg is required" && exit 1)

WORKDIR /usr/src/app

# Copy the packaged application
COPY ${FEDMGR_BUILD_REL_NPM_DIR}/letsfederate-fedmgr-*.tgz ./

# Install the package
RUN npm install ./letsfederate-fedmgr-*.tgz --omit=dev --ignore-scripts

# Install additional dependencies for federation admin
RUN npm install sqlite3 express jsonwebtoken node-fetch dotenv

FROM node:current-alpine3.21 AS final

# Install OpenSSL which is needed for key generation
RUN apk add --no-cache openssl

WORKDIR /usr/src/app

# Create necessary directories with proper ownership
RUN mkdir -p /usr/src/app/data/keys /usr/src/app/data/config /usr/src/app/public && \
    chown -R node:node /usr/src/app

# Copy from builder
COPY --chown=node:node --from=builder /usr/src/app/node_modules ./node_modules

# Copy the public directory for static files to the expected location
COPY --chown=node:node public/ ./public/

# Copy keys and federation configs
COPY --chown=node:node build/install/ ./build_data/

# Create bootstrap script
COPY --chown=node:node scripts/docker-bootstrap.sh ./bootstrap.sh
RUN chmod +x ./bootstrap.sh

USER node

# Set environment variable for public directory
ENV FEDMGR_PUBLIC_DIR=/usr/src/app/public

EXPOSE 3001

CMD ["./bootstrap.sh"]
