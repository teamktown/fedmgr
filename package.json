{
  "name": "fedmgr",
  "version": "1.0.0",
  "description": "`fedmgr` is a developer tool and orchestration engine for building, managing, and testing **identity federations** across **MCP servers**, **OIDC providers**, and **trust anchors**.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "scripts/run_tests.sh",
    "test:unit": "scripts/run_tests.sh --only-unit",
    "test:integration": "scripts/run_tests.sh --only-integration",
    "test:e2e": "scripts/run_tests.sh --only-e2e",
    "test:security": "scripts/run_tests.sh --only-security",
    "test:coverage": "scripts/run_tests.sh --with-coverage",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "cli": "node src/cli/fedmgr.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamktown/fedmgr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/teamktown/fedmgr/issues"
  },
  "homepage": "https://github.com/teamktown/fedmgr#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "node-jose": "^2.2.0",
    "open": "^8.4.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.3",
    "semantic-release": "^24.2.3",
    "sinon": "^15.2.0",
    "supertest": "^6.3.3"
  },
  "bin": {
    "fedmgr": "./src/cli/fedmgr.js"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
