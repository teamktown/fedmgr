{
  "name": "fedmgr",
  "version": "1.0.0",
  "description": "`fedmgr` is a developer tool and orchestration engine for building, managing, and testing **identity federations** across **MCP servers**, **OIDC providers**, and **trust anchors**.",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "scripts/run_tests.sh",
    "test:unit": "scripts/run_tests.sh --only-unit",
    "test:integration": "scripts/run_tests.sh --only-integration",
    "test:e2e": "scripts/run_tests.sh --only-e2e",
    "test:security": "scripts/run_tests.sh --only-security",
    "test:coverage": "scripts/run_tests.sh --with-coverage",
    "test:packages": "npm run test -ws --if-present",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "cli": "node src/fedmgr.js",
    "version": "scripts/run-conformance.sh",
    "tmi:keys:init": "bash scripts/tmi-keys-init.sh",
    "tmi:decrypt": "source scripts/tmi-decrypt.sh",
    "tmi:dev": "npm run dev -w @letsfederate/tmi-server",
    "tmi:start": "bash scripts/tmi-decrypt.sh --start",
    "ta:keys:init": "bash scripts/tmi-keys-init.sh packages/ta-server/keys",
    "ta:dev": "npm run dev -w @letsfederate/ta-server",
    "lab:up": "docker compose -f examples/lab/docker-compose.yml up --build",
    "lab:down": "docker compose -f examples/lab/docker-compose.yml down",
    "mcp:dev": "npm run dev -w @letsfederate/fedmgr-mcp",
    "mcp:start": "npm run start -w @letsfederate/fedmgr-mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamktown/fedmgr.git"
  },
  "keywords": [],
  "author": "Chris Phillips",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/teamktown/fedmgr/issues"
  },
  "homepage": "https://github.com/teamktown/fedmgr#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "fetch-blob": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-jose": "^2.2.0",
    "open": "^8.4.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "mocha": "^10.2.0",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "semantic-release": "^24.2.3",
    "semantic-release-monorepo": "^8.0.2",
    "sinon": "^15.2.0",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
