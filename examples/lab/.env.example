# examples/lab/.env.example
# Copy to examples/lab/.env and fill in your values.
# This file is safe to commit; .env is gitignored.

# Public URL of the TMI service (what clients will call)
TMI_ISSUER=http://localhost:8080

# Full URL to the JWKS endpoint (embedded in every trustmark JWS as `jku`)
TMI_JWKS_URL=http://localhost:8080/.well-known/jwks.json
